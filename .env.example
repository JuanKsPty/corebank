# ---------------------------------------------------------------------------
# corebank — copy this file to .env and run `docker compose up`.
# Every value below has a working default; nothing here is required to boot.
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=corebank
POSTGRES_PASSWORD=corebank
POSTGRES_DB=corebank
POSTGRES_PORT=5432

# --- TigerBeetle ------------------------------------------------------------
# Cluster ID 0 is the documented testing/benchmark cluster. It is pinned here
# (rather than randomly generated) so the ledger is reproducible across a
# fresh clone; TigerBeetle logs a warning about it, which is expected.
TB_CLUSTER_ID=0
TB_PORT=3001
# Grid cache. TigerBeetle reserves ~2.3 GiB at startup regardless, so give
# Docker at least 4 GiB of memory (6 GiB recommended).
TB_CACHE_GRID=256MiB

# --- API --------------------------------------------------------------------
API_PORT=8080
# development | production — production switches logs to JSON.
ENV=development
# debug | info | warn | error
LOG_LEVEL=info

# Signs access tokens; at least 32 characters. Left empty, the API generates
# one per process: everything works, but sessions do not survive a restart.
# There is deliberately no default value committed here — a signing secret in
# a public repository is not a secret.
JWT_SECRET=

# --- Frontend (development only) --------------------------------------------
WEB_PORT=5173
# Browser origins allowed to call the API directly. Only needed for
# `npm run dev`: in the container stack nginx serves the SPA and proxies /api
# on the same origin, so no CORS is involved.
CORS_ORIGINS=http://localhost:5173

# --- AI chat (optional) -----------------------------------------------------
# The chat assistant is the only feature that needs an external API key.
# Leave this empty and the whole application still runs: the chat panel
# reports that the assistant is not configured, and every REST endpoint,
# balance and transaction keeps working normally.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# How long a movement proposed by the assistant keeps its funds reserved while
# waiting for the user to confirm. When it elapses, TigerBeetle releases the
# reservation by itself — there is no cleanup job.
CONFIRMATION_TTL=2m
